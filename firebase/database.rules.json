{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "access": {
      "transmitters": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['name', 'approvedAt', 'approvedBy'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
          },
          "approvedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "approvedBy": {
            ".validate": "newData.val() === auth.uid"
          },
          "computer": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pairing": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['code', 'computer', 'requestedAt'])",
        "code": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$/)"
        },
        "computer": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "requestedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "devices": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && root.child('access/transmitters').child(auth.uid).exists()) || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['computer', 'lastSeen'])",
        "computer": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "antenna": {
          ".validate": "newData.isString() && newData.val().matches(/^(ok|stale|none|disconnected|simulated)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "audit": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$k": {
        ".write": "auth != null && !data.exists() && (root.child('access/transmitters').child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true || root.child('pairing').child(auth.uid).exists())",
        ".validate": "$k.matches(/^[0-9]{13}_[0-9]{6}$/) && newData.hasChildren(['type', 'uid', 'at']) && newData.child('uid').val() === auth.uid",
        "type": {
          ".validate": "newData.isString() && newData.val().matches(/^(pairing_request|auth_ok|revoked_detected|device_approved|device_revoked|admin_login|trajectory_start|trajectory_pause|trajectory_resume|trajectory_finish)$/)"
        },
        "uid": {
          ".validate": "newData.isString()"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "computer": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "detail": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "live": {
      ".read": true,
      ".write": "auth != null && root.child('access/transmitters').child(auth.uid).exists()",
      ".validate": "newData.hasChildren(['sessionId', 'status'])",
      "sessionId": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8}T[0-9]{6}Z_[0-9a-f]{6}$/)"
      },
      "status": {
        ".validate": "newData.isString() && newData.val().matches(/^(preparing|running|paused|resuming|finished)$/)"
      },
      "statusAt": {
        ".validate": "newData.isNumber() && newData.val() <= now"
      },
      "startedAt": {
        ".validate": "newData.isNumber() && newData.val() <= now"
      },
      "heartbeatAt": {
        ".validate": "newData.isNumber() && newData.val() <= now"
      },
      "source": {
        ".validate": "newData.isString() && newData.val().matches(/^(rx_serial|sim)$/)"
      },
      "points": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "lastKey": {
        ".validate": "newData.isString() && newData.val().length <= 24"
      },
      "antenna": {
        ".validate": "newData.hasChildren(['state'])",
        "state": {
          ".validate": "newData.isString() && newData.val().matches(/^(ok|stale|none|disconnected|simulated)$/)"
        },
        "ageS": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "sessions": {
      "$sid": {
        ".read": true,
        ".write": "auth != null && root.child('access/transmitters').child(auth.uid).exists()",
        ".validate": "$sid.matches(/^[0-9]{8}T[0-9]{6}Z_[0-9a-f]{6}$/)",
        "info": {
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(preparing|running|paused|resuming|finished)$/)"
          },
          "startedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "pausedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "resumedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "finishedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "source": {
            ".validate": "newData.isString() && newData.val().matches(/^(rx_serial|sim)$/)"
          },
          "gatewaySession": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        },
        "track": {
          "$k": {
            ".validate": "$k.matches(/^[0-9]{13}_[0-9]{6}$/) && newData.hasChildren(['n', 't'])",
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 1"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "seq": {
              ".validate": "newData.isNumber()"
            },
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lon": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "ga": {
              ".validate": "newData.isNumber()"
            },
            "ba": {
              ".validate": "newData.isNumber()"
            },
            "tc": {
              ".validate": "newData.isNumber()"
            },
            "pa": {
              ".validate": "newData.isNumber()"
            },
            "hu": {
              ".validate": "newData.isNumber()"
            },
            "sat": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "pv": {
              ".validate": "newData.isNumber()"
            },
            "fix": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "events": {
          "$k": {
            ".validate": "$k.matches(/^[0-9]{13}_[0-9]{6}$/) && newData.hasChildren(['type', 'at'])",
            "type": {
              ".validate": "newData.isString() && newData.val().matches(/^(start|pause|resume|finish)$/)"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sessoes": {
      "$sid": {
        ".read": "auth != null && $sid.length >= 24 && data.child('expira').val() > now",
        ".write": "auth != null && $sid.length >= 24 && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['host', 'expira', 'pareamentoAte'])",
        "host": {
          ".validate": "newData.val() === auth.uid && (!data.exists() || data.val() === newData.val())"
        },
        "criada": {
          ".validate": "newData.isNumber()"
        },
        "expira": {
          ".validate": "newData.isNumber() && newData.val() <= now + 7260000"
        },
        "pareamentoAte": {
          ".validate": "newData.isNumber() && newData.val() <= now + 660000"
        },
        "controle": {
          ".write": "auth != null && data.parent().child('expira').val() > now && ((!data.exists() && newData.val() === auth.uid && data.parent().child('pareamentoAte').val() > now) || data.val() === auth.uid)",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "presenca": {
          "host": {
            ".validate": "newData.isBoolean()"
          },
          "controle": {
            ".write": "auth != null && data.parent().parent().child('controle').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          },
          "$outro": {
            ".validate": false
          }
        },
        "comando": {
          ".write": "auth != null && data.parent().child('controle').val() === auth.uid && data.parent().child('expira').val() > now",
          ".validate": "newData.hasChildren(['tipo', 'seq', 't']) && newData.child('tipo').isString() && newData.child('tipo').val().matches(/^(subir|descer|subir-segurar|descer-segurar|parar|proxima|anterior|inicio|fim|pausar|retomar|roteiro|roteiro-sair|modulo-proximo|modulo-anterior|modulo-inicio|modulo-fim|modulo-ir)$/) && newData.child('seq').isNumber() && newData.child('seq').val() > (data.child('seq').exists() ? data.child('seq').val() : 0) && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000",
          "arg": {
            ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^[a-z0-9,-]*$/)"
          },
          "$outro": {
            ".validate": "$outro === 'tipo' || $outro === 'seq' || $outro === 't' || $outro === 'arg'"
          }
        },
        "estado": {
          ".validate": "newData.hasChildren(['secao', 'total', 'nome', 'pausado'])"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "codigos": {
      "$cod": {
        ".read": "auth != null && $cod.length === 8 && data.child('expira').val() > now",
        ".write": "auth != null && $cod.length === 8 && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.hasChildren(['sid', 'host', 'expira']) && newData.child('sid').isString() && newData.child('sid').val().length >= 24 && newData.child('expira').isNumber() && newData.child('expira').val() <= now + 660000)"
      }
    }
  }
}
